NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://lms_admin:your_secure_password@localhost:5432/lms_db
DATABASE_SSL=false
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
