{
  // Use Prettier as the default formatter for everything.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // Per-language overrides so the built-in TS formatter never wins.
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Match Prettier so manual indentation also stays 2-space.
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // Run ESLint --fix on save AFTER Prettier, so prettier/prettier auto-corrects.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Use the workspace's pinned TypeScript instead of VS Code's bundled one.
  "typescript.tsdk": "node_modules/typescript/lib",

  // ESLint flat-config compatibility.
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "typescript"],

  // Hide build noise from the file tree / search.
  "files.exclude": {
    "**/dist": true,
    "**/coverage": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/coverage": true,
    "**/pnpm-lock.yaml": true
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}